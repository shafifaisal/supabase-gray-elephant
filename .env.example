# ---------------------------------------------------------------------------
# iPassGenerator — environment template
# Copy to `.env.local` for development. NEVER commit a real .env file.
# NEVER reuse production secrets in preview environments.
# ---------------------------------------------------------------------------

# Canonical public site origin. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (browser-safe publishable values only) ----------------------
# Find these at: Supabase Dashboard > Project Settings > API
# These are SAFE to expose to the browser, but only because RLS is enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only secrets) ---------------------------------------
# Server Actions / Route Handlers / migrations. NEVER prefix with NEXT_PUBLIC_,
# NEVER import into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# Used by supabase SSR for cookie-based sessions in Server Components.
SUPABASE_SERVICE_ROLE_KEY_SERVER_ONLY=

# --- Site / brand (safe defaults, overridable in admin settings) -----------
NEXT_PUBLIC_SITE_NAME=iPassGenerator
NEXT_PUBLIC_SITE_URL_DEFAULT=https://ipassgenerator.online

# --- Analytics (optional, consent-gated) ----------------------------------
# Leave empty to keep analytics fully disabled.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Advertising (optional, admin-controlled, consent-gated) --------------
# Leave empty until the AdSense readiness checklist is complete. A placeholder
# or fabricated publisher ID is never used — ads stay off without a real one.
# NEXT_PUBLIC_ADSENSE_CLIENT_ID must look like ca-pub-XXXXXXXXXXXXXXXX.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
# Deployment-level kill switch. Ads run only when this is exactly "true" AND
# the admin "adsense_enabled" setting is on AND a valid publisher ID is set.
NEXT_PUBLIC_ADSENSE_ENABLED=false
# Ad unit slot IDs (from the AdSense dashboard), per placement.
NEXT_PUBLIC_ADSENSE_SLOT_GUIDES=

# --- Consent (optional CMP) ------------------------------------------------
# Google-certified CMP partner tag or self-hosted CMP id, if used.
NEXT_PUBLIC_CMP_ID=

# --- Contact form rate limiting (server-only) -----------------------------
CONTACT_RATE_LIMIT_PER_HOUR=5

# --- Security / misc ------------------------------------------------------
NEXT_PUBLIC_ENABLE_VERBOSE_ERRORS=false